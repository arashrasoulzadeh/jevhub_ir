# کپی کنید به .env و مقداردهی کنید — اسکریپت‌های .build-scripts/*.py و
# docker-compose.yml هر دو این فایل را می‌خوانند

# دامنه‌ی کامل سایت، بدون اسلش انتهایی (برای canonical، og:url، JSON-LD و sitemap.xml)
SITE_URL=https://jevhub.ir

# شناسه‌ی اندازه‌گیری Google Analytics (gtag.js)
GA_MEASUREMENT_ID=G-QV7SENV5V1

# پورت هاست برای docker-compose (کانتینر همیشه داخلش روی 80 گوش می‌دهد).
# روی هر سرور قبل از تنظیم، با `ss -ltn` یا `netstat -nltp` یک پورت آزاد
# پیدا کنید — این مقدار فقط یک پیش‌فرض است.
APP_PORT=8088

# کلیدهای ARCaptcha (arcaptcha.ir) — سرویس gate (docker/gate/) از این‌ها
# برای تأیید کپچای Playground استفاده می‌کند، وقتی یک IP از نرخ مجاز رد
# شود. از https://arcaptcha.ir/dashboard بگیرید (نه Cloudflare Turnstile؛
# این پروژه روی ArvanCloud میزبانی می‌شود و Cloudflare معمولاً برای
# حساب‌های ایرانی در دسترس نیست — ArvanCloud هم خودش ARCaptcha را به‌عنوان
# یکی از گزینه‌های کپچا پیشنهاد می‌دهد).
# هر دو کلید را خالی بگذارید تا کپچا کلاً غیرفعال بماند (فقط
# نرخ‌محدودسازی + چک Origin در nginx فعال می‌مانند).
# SITE_KEY محرمانه نیست، اما چون کلاینت (assets/js/config.js) هم به همین
# مقدار نیاز دارد، آن را دستی و یکسان در هر دو جا وارد کنید.
ARCAPTCHA_SITE_KEY=
ARCAPTCHA_SECRET_KEY=
